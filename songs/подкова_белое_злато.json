{
  "title": "Белое Злато - Подкова",
  "parts": [
    {
      "id": "verse1",
      "label": "Куплет 1",
      "lines": [
        "Песня несётся издали",
        "Где-то слышится звон колокольный",
        "Там в доме прибита на двери",
        "Удачу приносит и хранит"
      ]
    },
    {
      "id": "chorus1",
      "label": "Припев 1",
      "lines": [
        "Подкова, подкова ты моя",
        "Ты счастья так много принесла",
        "Погода, погода лютая",
        "Но благодаря тебе",
        "На сердечке лишь весна"

      ]
    },
    {
      "id": "chorus2",
      "label": "Припев 2",
      "lines": [
        "Подкова, подкова ты моя",
        "Ты счастья так много принесла",
        "Погода, погода лютая",
        "Но благодаря тебе",
        "На сердечке лишь весна"
      ]
    },
    {
      "id": "verse2",
      "label": "Куплет 2",
      "lines": [
            "Мчу я по полю-полюшку",
            "Что же ждёт впереди меня – не знаю",
            "Выпадет, что на долюшку",
            "Мне мама твердила: «Ой, не ходи по краю»"
      ]
    },
    {
      "id": "verse3",
      "label": "Куплет 3",
      "lines": [
            "Ветер доносит голоса",
            "Будто шепчет судьбы моей дороги",
            "Знаю, подкова неспроста",
            "От беды оберег и от тревоги"
      ]
    },
    {
      "id": "chorus3",
      "label": "Припев 3",
      "lines": [
            "Подкова, подкова ты моя",
            "Ты счастья так много принесла",
            "Погода, погода лютая",
            "Но благодаря тебе",
            "На сердечке лишь весна"
      ]
    }
  ]
